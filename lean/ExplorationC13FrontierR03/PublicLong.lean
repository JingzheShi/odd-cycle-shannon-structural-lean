/-! ### The bound -/

/-- `M` is the size of the terminal code on the 3 terminal nodes. -/
theorem stepM : M = code3 K sn17 sn37 sn48 := by
  native_decide

/-- The exponents of the 3 terminal children. -/
def eT : Fin 3 → Nat := Fin.cases 34 (Fin.cases 36 (fun _ => 17))

/-- The terminal children. -/
def terminalChildren (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (eT i)) :=
  Fin.cases (Rn17 R) (Fin.cases (Rn37 R) (fun _ => (Rn48 R)))

/-- **The bound.**  A port system whose seven families have the sizes of `w0` gives an
independent set of size `M` in `G^(box 87)`. -/
theorem bound (S : RichPortSystem G) (hw : ∀ a, (S.fam a).card = w0 a) :
    M ≤ (SimpleGraph.strongPower G 87).indepNum := by
  have h : ∀ a, S.toRealisation.w a = w0 a := hw
  have hc := sum_code3 K (terminalChildren S.toRealisation) sn17 sn37 sn48
    (fun b => wn17 S.toRealisation h b) (fun b => wn37 S.toRealisation h b) (fun b => wn48 S.toRealisation h b)
  exact le_trans (le_of_eq (stepM.trans hc.symm))
    (le_indepNum_multiCode eT (terminalChildren S.toRealisation) K)

